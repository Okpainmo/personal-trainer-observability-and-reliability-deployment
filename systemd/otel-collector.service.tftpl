[Unit]
Description=OpenTelemetry Collector
Wants=network-online.target
After=network-online.target loki.service tempo.service

[Service]
User=root
Group=root
Type=simple
ExecStart=/usr/local/bin/otelcol-contrib --config=${config_dir}/otel-collector/config.yml
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
