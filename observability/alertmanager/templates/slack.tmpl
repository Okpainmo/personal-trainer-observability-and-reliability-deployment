{{ define "slack.color" -}}
{{ if eq .Status "resolved" }}good{{ else if eq .CommonLabels.severity "critical" }}danger{{ else }}warning{{ end }}
{{- end }}

{{ define "slack.title" -}}
[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} / {{ .CommonLabels.severity }}
{{- end }}

{{ define "slack.text" -}}
{{ range .Alerts }}
*Alert:* {{ .Labels.alertname }}
*Severity:* {{ .Labels.severity }}
*Service:* {{ .Labels.service }}
*Host/Instance:* {{ if .Labels.instance }}{{ .Labels.instance }}{{ else }}n/a{{ end }}
*Current value:* {{ if .Annotations.current_value }}{{ .Annotations.current_value }}{{ else }}n/a{{ end }}
*Summary:* {{ .Annotations.summary }}
*Status:* {{ .Status }}
*Started:* {{ .StartsAt }}
*Resolved:* {{ if .EndsAt }}{{ .EndsAt }}{{ else }}n/a{{ end }}
*Dashboard:* {{ .Annotations.dashboard_url }}
*Runbook:* {{ .Annotations.runbook_url }}
{{ end }}
{{- end }}
