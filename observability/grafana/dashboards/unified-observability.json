{
  "uid": "unified-observability",
  "title": "Unified Observability",
  "tags": ["metrics", "logs", "traces"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total, service)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "personal-trainer-be",
          "value": "personal-trainer-be"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 7},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(http_requests_total{service=\"$service\"}[5m])) by (route, status)",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 7},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(http_requests_total{service=\"$service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"$service\"}[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50/p95/p99",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 7},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Service Logs",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 10},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service_name=\"$service\"} | json",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Trace-Correlated Logs",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 10},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service_name=\"$service\"} | json | trace_id != \"\"",
          "refId": "A"
        }
      ]
    },
    {
      "type": "traces",
      "title": "Recent Traces",
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 10},
      "targets": [
        {
          "datasource": {"type": "tempo", "uid": "tempo"},
          "query": "{ resource.service.name = \"$service\" }",
          "queryType": "traceql",
          "refId": "A"
        }
      ]
    }
  ]
}
